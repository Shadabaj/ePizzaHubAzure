{
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Error"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "wwwroot\\Logs\\log.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "outputTemplate": "{UtcTimestamp:yyyy-MM-dd } {Message}{NewLine:1}{Exception:1}",
          "rollingInterval": "Hour",
          "shared": true
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DbConnection",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "schemaName": "dbo",
            "autoCreateSqlTable": true
          },
          "restrictedToMinimumLevel": "Error"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "Serilog.ePizzaHub"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "VaultUri": "https://your-key-vault.vault.azure.net/"
  },
  "ConnectionStrings": {
    "DbConnection": "",
    "RedisCache": "",
    "ServiceBus": ""
  },
  "Storage": {
    "Connection": "",
    "ImageAddress": "https://your-storage-account.example/",
    "Container": "images"
  },
  "RazorPay": {
    "Key": "",
    "Secret": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
